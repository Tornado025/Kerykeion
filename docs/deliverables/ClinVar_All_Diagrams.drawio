        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n3" value="SECOND NORMAL FORM  2NF" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#202020;fillColor=#ffffff;fontColor=#111111;text;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=center;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1840" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Changes from 1NF: none" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#202020;fillColor=#ffffff;fontColor=#111111;text;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;align=center;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="74" width="1820" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="All twelve 1NF relations already satisfy 2NF. No relation is split and no attribute or key changes at this stage." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#202020;fillColor=#ffffff;fontColor=#111111;text;strokeColor=none;fillColor=none;fontSize=32;fontStyle=0;align=left;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="130" y="220" width="1640" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="No nonprime attribute has a partial dependency on a candidate key. ASSERTION_VERSION and VARIANT_STATE need their complete composite keys. DRIFT_PREDICTION needs its full alternate scope key. The remaining declared keys are single-column identifiers." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#202020;fillColor=#ffffff;fontColor=#111111;text;strokeColor=none;fillColor=none;fontSize=27;fontStyle=0;align=left;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="130" y="420" width="1640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Carry the 1NF schema forward unchanged. The 3NF sheets show only VARIANT_STATE, CLASS_CONFLICT_RULE and CHANGE_EVENT changes." style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;strokeColor=#202020;fillColor=#ffffff;fontColor=#111111;text;strokeColor=none;fillColor=none;fontSize=29;fontStyle=0;align=left;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="130" y="690" width="1640" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
