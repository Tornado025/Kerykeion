  <diagram name="08 2NF Changes from 1NF" id="clinvar-v5-7">
    <mxGraphModel dx="1900" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0" background="#ffffff">
