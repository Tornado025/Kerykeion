DATABASE_URL=postgresql://kerykeion:local-demo-only@localhost:55433/kerykeion
MONGO_URI=mongodb://localhost:27018
MONGO_DB=kerykeion
NEO4J_URI=bolt://localhost:17688
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-demo-only
# Local-only demo. Set WRITE_TOKEN to enable protected import/replay API operations.
WRITE_TOKEN=

# Email/password authentication. Disable only for a trusted local demo.
AUTH_ENABLED=true
# Generate once: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET=
# Set true behind HTTPS in production; false is for localhost HTTP only.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001,http://127.0.0.1:5173,http://localhost:5173
# SendGrid key restricted to Mail Send; sender must be verified in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
